# Local development. Production requires an external PostgreSQL database.
HOST=127.0.0.1
PORT=3301
VITE_PORT=5180
WASIT_DB=data/wasit.sqlite
# DATABASE_URL=postgresql://...
# WASIT_SESSION_SECRET=at-least-32-random-private-bytes
# WASIT_PUBLIC_ORIGIN=https://wasit-id.vercel.app
# WASIT_ALLOWED_ORIGINS=https://wasit-id.vercel.app
# Optional runtime models. Leave unset for rules fallback; image reading then remains unavailable.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_MODEL_BUYER=
# OPENAI_MODEL_EXTRACTOR=
# OPENAI_MODEL_PROVIDER=
# OPENAI_MODEL_FORMATTER=
# OPENAI_MODEL_SUPPORT=

# Shared UTC daily model attempt cap; exceeded calls use rules/manual entry.
WASIT_MODEL_DAILY_CALL_LIMIT=500

# Bounded response deadline; capped at 20 seconds.
OPENAI_TIMEOUT_MS=12000
